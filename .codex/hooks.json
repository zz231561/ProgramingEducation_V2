{
  "description": "Claude Code / Codex 共用規則的 lifecycle adapters。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_config_hook.py\" check",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/scripts/agent_config_hook.py\" check",
            "timeout": 10,
            "statusMessage": "檢查 Claude Code / Codex 規則是否同步"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_config_hook.py\" guard-generated",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/scripts/agent_config_hook.py\" guard-generated",
            "timeout": 10,
            "statusMessage": "保護 generated agent config"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_config_hook.py\" sync-after-edit",
            "commandWindows": "py -3 \"$(git rev-parse --show-toplevel)/scripts/agent_config_hook.py\" sync-after-edit",
            "timeout": 10,
            "statusMessage": "同步 canonical agent config"
          }
        ]
      }
    ]
  }
}
