# B 機 runner 環境變數（複製為 .env，勿進版控）
#
# RUNNER_TOKEN 必須與 A 機 backend 的 RUNNER_TOKEN 完全一致。
# 產生方式：openssl rand -hex 32

RUNNER_TOKEN=

# 沙箱模式：nsjail（生產）/ none（僅本機測試，無隔離）
RUNNER_SANDBOX=nsjail

# 以下皆有預設值（docs/server-plan.md 參數表），需要調整時才取消註解
# RUNNER_GATE_SLOTS=2
# RUNNER_QUEUE_TIMEOUT=30
# RUNNER_COMPILE_WALL=10
# RUNNER_COMPILE_RAM_MB=512
# RUNNER_EXEC_WALL=10
# RUNNER_EXEC_CPU=5
# RUNNER_EXEC_RAM_MB=256
# RUNNER_EXEC_PIDS=64
# RUNNER_OUTPUT_LIMIT=8388608
# RUNNER_SESSION_IDLE=60
# RUNNER_SESSION_HARD=300
# RUNNER_MAX_SESSIONS=40
# RUNNER_CACHE_MAX=256
