# === Auth (NextAuth.js v5) ===
# 產生方式：npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 生產環境（Zeabur / nginx 反代後）必須設 true
# NextAuth v5 預設不信任 X-Forwarded-Host，否則 callback URL 會用容器 internal hostname 而非公開 domain
# Dev 跑 localhost 時不需設（NextAuth 自動 trust localhost）
# AUTH_TRUST_HOST=true

# === Backend proxy ===
BACKEND_URL=http://localhost:8000

# === 互動終端 WS（7-R）===
# 瀏覽器直連 backend（Next.js Route Handler 無法 proxy WebSocket），需公開子網域。
# 未設定時退回同源 /terminal/ws；本機 dev 指向 backend port。
# NEXT_PUBLIC_TERMINAL_WS_URL=ws://localhost:8000/terminal/ws
